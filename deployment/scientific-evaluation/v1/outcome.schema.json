{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Private post-lock analysis projection and v1 failure taxonomy",
  "type": "object", "additionalProperties": false,
  "required": ["item_id", "arm", "status", "pass", "errors"],
  "properties": {
    "item_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "arm": {"enum": ["A", "B"]},
    "status": {"enum": ["scored", "inference_failure", "pending_review", "sandbox_unavailable", "scoring_error"]},
    "pass": {"enum": [0, 1, null]},
    "errors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/classification"}},
    "new_tokens": {"type": "integer", "minimum": 1, "maximum": 384},
    "latency_s": {"type": "number", "exclusiveMinimum": 0},
    "truncated": {"type": "boolean"}
  },
  "definitions": {
    "classification": {"enum": [
      "empty_answer", "format_error", "wrong_answer", "invalid_option", "wrong_unit", "numeric_error",
      "unknown_reference", "missing_citation", "attribution_error", "unsupported_claim", "missing_required_claim",
      "unnecessary_abstention", "wrong_abstention_reason", "failure_to_abstain", "resource_limit",
      "candidate_error", "test_failure", "sandbox_error", "expert_criterion_failure", "invalid_item",
      "context_overflow", "oom", "timeout", "nonfinite_logits", "backend_error", "worker_lost"
    ]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "scored"}}},
     "then": {"properties": {"pass": {"enum": [0, 1]}}},
     "else": {"properties": {"pass": {"type": "null"}}}},
    {"if": {"properties": {"pass": {"const": 1}}},
     "then": {"properties": {"errors": {"maxItems": 0}}}},
    {"if": {"properties": {"pass": {"const": 0}}},
     "then": {"properties": {"errors": {"minItems": 1}}}}
  ]
}
